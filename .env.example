# Copy to .env and fill in. .env is git-ignored; never commit real values.
# In production these live in the Vercel project's environment settings.

# Turso (libSQL) database. Leave both empty in local dev — the app then
# uses a local SQLite file at ./data/myturn.db, no cloud account needed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob for avatar photos. Injected automatically by Vercel; leave
# empty in local dev — photos then live as files under ./data/avatars.
BLOB_READ_WRITE_TOKEN=

# Resend API key for sending magic-link emails. Leave empty in local dev:
# the magic link is printed to the server log instead of being emailed.
RESEND_API_KEY=

# From address for magic-link emails (a domain verified in Resend).
MAIL_FROM=myturn <login@example.com>

# Real family emails for provisioning (pnpm db:seed). The people table is
# the auth allowlist — these are the addresses that can sign in. Never
# commit real addresses; set them here in the gitignored .env.
SEED_EMAIL_TODD=
SEED_EMAIL_KAREN=
SEED_EMAIL_CHAD=
SEED_EMAIL_KATHY=

# Public base URL used inside magic-link emails. In production:
# https://myturn.toddtech.llc
APP_BASE_URL=http://localhost:3000
