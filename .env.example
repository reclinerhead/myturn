# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Path to the SQLite database file. In Docker this is set by the image
# (/data/myturn.db on the myturn-data volume); this value is for local dev.
DATABASE_PATH=./data/myturn.db

# Resend API key for sending magic-link emails. Leave empty in local dev:
# the magic link is printed to the server log instead of being emailed.
RESEND_API_KEY=

# From address for magic-link emails (a domain verified in Resend).
MAIL_FROM=myturn <login@example.com>

# Secret for signing/hashing auth tokens (issue #4). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Public base URL used inside magic-link emails (issue #4).
APP_BASE_URL=http://localhost:3000

# Cloudflare Tunnel token (issue #5). Only needed when running the
# `tunnel` compose profile on the server.
CLOUDFLARE_TUNNEL_TOKEN=
